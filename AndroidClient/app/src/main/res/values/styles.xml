<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#197D68</item>
        <item name="android:statusBarColor">#F7F9F8</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#F7F9F8</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">#F7F9F8</item>
    </style>
    <style name="SyncCaptureTheme" parent="android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
