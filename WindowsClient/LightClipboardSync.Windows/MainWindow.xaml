<Window x:Class="LightClipboardSync.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/LightClipboardSync.ico"
        Title="剪贴板同步" Width="520" Height="405"
        MinWidth="460" MinHeight="360" WindowStartupLocation="CenterScreen">
  <Grid Margin="26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="22"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="剪贴板同步" FontSize="26" FontWeight="SemiBold" />
      <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#F59E0B" VerticalAlignment="Center" />
        <TextBlock x:Name="StatusText" Text="正在连接" Foreground="#64748B" Margin="8,0,0,0" />
      </StackPanel>
    </StackPanel>
    <Border Grid.Row="2" Padding="16" Background="#F1F5F9" CornerRadius="8">
      <StackPanel>
        <TextBlock Text="同步设置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="服务器地址" VerticalAlignment="Center" />
          <TextBox x:Name="EndpointBox" Grid.Column="1" Padding="7" />
          <TextBlock Text="同步 UUID" Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,0" />
          <Grid Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SharedIdBox" Padding="7" />
            <Button Content="复制" Grid.Column="1" Margin="8,0,0,0" Padding="10,5" Click="CopyId_Click" />
            <Button Content="重新生成" Grid.Column="2" Margin="8,0,0,0" Padding="10,5" Click="RegenerateId_Click" />
          </Grid>
        </Grid>
      </StackPanel>
    </Border>
    <CheckBox x:Name="AutostartBox" Grid.Row="4" Content="开机自启动" VerticalAlignment="Center"
              Checked="AutostartBox_Changed" Unchecked="AutostartBox_Changed" />
    <TextBlock Grid.Row="5" Text="后台服务会持续监听剪贴板。关闭此窗口不会停止同步。" Foreground="#64748B"
               VerticalAlignment="Top" Margin="0,16,0,0" TextWrapping="Wrap" />
    <Grid Grid.Row="6" Margin="0,18,0,0">
      <Button Content="完全退出" Padding="14,7" HorizontalAlignment="Left" Click="Exit_Click" />
      <Button Content="保存设置" Padding="18,7" HorizontalAlignment="Right"
              Background="{StaticResource AccentBrush}" Foreground="White" Click="Save_Click" />
    </Grid>
  </Grid>
</Window>
